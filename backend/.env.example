# Copy to backend/.env for local development. Never commit real secrets.

# Django
SECRET_KEY=insecure-dev-secret-key-change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (docker compose provides this automatically for containers)
DATABASE_URL=postgres://spotter:spotter_dev_password@localhost:5432/spotter

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# Run Celery tasks inline (no worker needed) for free-tier demos.
CELERY_TASK_ALWAYS_EAGER=0

# External APIs
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
# Geocoding provider: "openrouteservice" (key) or "photon" (keyless).
GEOCODING_PROVIDER=openrouteservice
PHOTON_BASE_URL=https://photon.komoot.io
PHOTON_HEALTHCHECK_ENABLED=0
OSRM_BASE_URL=https://router.project-osrm.org
# Active weather provider (keyless, US-only). No API key or credit card.
NWS_BASE_URL=https://api.weather.gov
NWS_USER_AGENT=Routing-Assessment/1.0
NWS_HEALTHCHECK_ENABLED=0
EXTERNAL_API_TIMEOUT=5.0
ROUTING_TIMEOUT=30.0
WEATHER_TIMEOUT=10.0

# CORS (frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173
