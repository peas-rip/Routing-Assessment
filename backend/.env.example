# Copy to backend/.env for local development. Never commit real secrets.

# Django
SECRET_KEY=insecure-dev-secret-key-change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (docker compose provides this automatically for containers)
DATABASE_URL=postgres://spotter:spotter_dev_password@localhost:5432/spotter

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# External APIs
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim is keyless; enable its live /health/ probe only if desired.
NOMINATIM_HEALTHCHECK_ENABLED=0
NOMINATIM_USER_AGENT=Routing-Assessment/1.0
# Active routing provider (keyless). Override to point at a self-hosted OSRM.
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# Open-Meteo is keyless; enable its live /health/ probe only if desired.
OPEN_METEO_HEALTHCHECK_ENABLED=0
EXTERNAL_API_TIMEOUT=5.0
ROUTING_TIMEOUT=30.0
WEATHER_TIMEOUT=10.0

# CORS (frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://ui-ux-improvement-cap2noys-1.v0.build
